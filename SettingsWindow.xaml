<Window
    x:Class="FluentClip.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FluentClip 设置与缓存管理">

    <Grid x:Name="SettingsRootGrid" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Fluent TitleBar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="18,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE713;" FontSize="15" />
                <TextBlock Text="FluentClip 设置与缓存中心" FontSize="13" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="24,8,24,28" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" MaxWidth="620">

                <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" CornerRadius="8" />

                <!-- Card 1: Cache Directory & Storage Quota -->
                <Border CornerRadius="10"
                        Padding="18"
                        BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="3">
                            <TextBlock Text="缓存目录与图片存储治理" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="原图与缩略图采用 SHA-256 内容去重存储，支持自定义任意磁盘路径并无损迁移现有记录。"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <!-- Storage Usage Meter -->
                        <Border CornerRadius="8"
                                Padding="14,12"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="StorageStatsText"
                                               Text="正在读取缓存占用..."
                                               FontSize="12.5"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="StorageQuotaLabel"
                                               Grid.Column="1"
                                               Text="上限 500 MB"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <ProgressBar x:Name="StorageProgressBar" Minimum="0" Maximum="100" Value="0" Height="6" CornerRadius="3" />
                                <TextBlock x:Name="StorageBreakdownText"
                                           Text="共 0 条记录"
                                           FontSize="11.5"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Directory Path Selector -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="当前缓存存储目录" FontSize="13" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CacheDirTextBox"
                                         Grid.Column="0"
                                         PlaceholderText="例如 D:\ClipboardCache"
                                         CornerRadius="7" />
                                <Button Grid.Column="1"
                                        CornerRadius="7"
                                        Content="浏览选择..."
                                        Click="BrowseCacheDirBtn_Click" />
                                <Button Grid.Column="2"
                                        CornerRadius="7"
                                        ToolTipService.ToolTip="在资源管理器中打开当前缓存目录"
                                        Content="打开文件夹"
                                        Click="OpenCacheDirBtn_Click" />
                            </Grid>

                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="MigrateExistingCheckBox"
                                          IsChecked="True"
                                          Content="切换时自动迁移旧目录中的全部历史记录与图片"
                                          FontSize="12.5" />
                                <Button x:Name="ApplyCacheDirBtn"
                                        Grid.Column="1"
                                        Style="{StaticResource AccentButtonStyle}"
                                        CornerRadius="7"
                                        Content="应用新缓存目录"
                                        Click="ApplyCacheDirBtn_Click" />
                            </Grid>
                        </StackPanel>

                        <MenuFlyoutSeparator />

                        <!-- Quotas & One-Click Cleanup -->
                        <Grid ColumnSpacing="14" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="图片缓存空间上限" FontSize="12.5" />
                                <ComboBox x:Name="MaxSizeCombo" HorizontalAlignment="Stretch" SelectionChanged="QuotaCombo_SelectionChanged">
                                    <ComboBoxItem Content="100 MB" Tag="100" />
                                    <ComboBoxItem Content="300 MB" Tag="300" />
                                    <ComboBoxItem Content="500 MB (推荐)" Tag="500" />
                                    <ComboBoxItem Content="1 GB (1024 MB)" Tag="1024" />
                                    <ComboBoxItem Content="2 GB (2048 MB)" Tag="2048" />
                                    <ComboBoxItem Content="不限制空间" Tag="0" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="最大历史保留条数" FontSize="12.5" />
                                <ComboBox x:Name="MaxCountCombo" HorizontalAlignment="Stretch" SelectionChanged="QuotaCombo_SelectionChanged">
                                    <ComboBoxItem Content="200 条" Tag="200" />
                                    <ComboBoxItem Content="500 条 (推荐)" Tag="500" />
                                    <ComboBoxItem Content="1000 条" Tag="1000" />
                                    <ComboBoxItem Content="2000 条" Tag="2000" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Button HorizontalAlignment="Left"
                                CornerRadius="7"
                                Content="立即清理所有未收藏缓存（保留 ★ 收藏项）"
                                Click="CleanUnpinnedCacheBtn_Click" />
                    </StackPanel>
                </Border>

                <!-- Card 2: Global Hotkey & Behavior -->
                <Border CornerRadius="10"
                        Padding="18"
                        BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="全局快捷键与系统行为" FontSize="16" FontWeight="SemiBold" />

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="全局呼出快捷键" FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock x:Name="CurrentHotkeySubtext"
                                           Text="当前生效: Alt + V"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <ComboBox x:Name="PresetHotkeyCombo"
                                      Grid.Column="1"
                                      Width="165"
                                      VerticalAlignment="Center"
                                      SelectionChanged="PresetHotkeyCombo_SelectionChanged">
                                <ComboBoxItem Content="Alt + V (默认)" Tag="1:86:Alt + V" />
                                <ComboBoxItem Content="Ctrl + Shift + V" Tag="6:86:Ctrl + Shift + V" />
                                <ComboBoxItem Content="Alt + `" Tag="1:192:Alt + `" />
                                <ComboBoxItem Content="Ctrl + Alt + V" Tag="3:86:Ctrl + Alt + V" />
                                <ComboBoxItem Content="Alt + C" Tag="1:67:Alt + C" />
                            </ComboBox>

                            <Button x:Name="RecordHotkeyBtn"
                                    Grid.Column="2"
                                    CornerRadius="7"
                                    VerticalAlignment="Center"
                                    Content="录制自定义键位"
                                    Click="RecordHotkeyBtn_Click"
                                    LostFocus="RecordHotkeyBtn_LostFocus"
                                    PreviewKeyDown="RecordHotkeyBtn_PreviewKeyDown" />
                        </Grid>

                        <MenuFlyoutSeparator />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="跟随输入光标或鼠标位置弹出" FontSize="13.5" />
                                <TextBlock Text="开启后自动定位在打字光标旁并防溢出屏幕边缘；关闭则在鼠标屏幕居中区域显示"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="FollowCaretSwitch" Grid.Column="1" OnContent="开启" OffContent="关闭" Toggled="FollowCaretSwitch_Toggled" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="开机自动静默启动至系统托盘" FontSize="13.5" />
                                <TextBlock Text="登录 Windows 时后台无感就绪，零轮询不占 CPU"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AutoStartSwitch" Grid.Column="1" OnContent="开启" OffContent="关闭" Toggled="AutoStartSwitch_Toggled" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 3: Theme & About -->
                <Border CornerRadius="10"
                        Padding="18"
                        BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="界面色彩主题" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="基于 Windows 11 原生 WinUI 3 + .NET Native AOT 编译"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="150" VerticalAlignment="Center" SelectionChanged="ThemeCombo_SelectionChanged">
                            <ComboBoxItem Content="跟随系统" Tag="System" />
                            <ComboBoxItem Content="深色模式" Tag="Dark" />
                            <ComboBoxItem Content="浅色模式" Tag="Light" />
                        </ComboBox>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
