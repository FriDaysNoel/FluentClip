<Window
    x:Class="FluentClip.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FluentClip 设置">

    <Grid x:Name="SettingsRootGrid">
        <Grid.Resources>
            <!-- One settings row: icon · title + description · control (PowerToys / Windows Settings layout) -->
            <Style x:Key="SettingsCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="16,12,16,12" />
                <Setter Property="MinHeight" Value="68" />
            </Style>
            <Style x:Key="GroupHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="1,28,0,8" />
            </Style>
            <Style x:Key="CardDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="CardIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Margin" Value="2,0,20,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/AppIcon.png" Width="16" Height="16" />
                <TextBlock Text="FluentClip 设置" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        OpenPaneLength="240"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False"
                        SelectionChanged="NavView_SelectionChanged"
                        ItemInvoked="NavView_ItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="常规" Tag="General">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="存储与缓存" Tag="Storage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEDA2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="关于" Tag="About">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <!-- Way back to the clipboard panel (previously there was none) -->
                <NavigationViewItem x:Name="OpenPanelNavItem" Content="打开剪贴板面板" Tag="OpenPanel" SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8C8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="1000" Padding="40,8,40,40" HorizontalAlignment="Stretch">
                    <TextBlock x:Name="PageTitle" Text="常规" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8" />
                    <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" Margin="0,8,0,0" />

                    <!-- ===================== 常规 ===================== -->
                    <StackPanel x:Name="GeneralPage" Spacing="4">
                        <TextBlock Text="激活" Style="{StaticResource GroupHeaderStyle}" />

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE765;" Style="{StaticResource CardIconStyle}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="全局呼出快捷键" />
                                    <TextBlock x:Name="CurrentHotkeySubtext" Text="当前生效: Alt + V" Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ComboBox x:Name="PresetHotkeyCombo" Width="170" SelectionChanged="PresetHotkeyCombo_SelectionChanged">
                                        <ComboBoxItem Content="Alt + V (默认)" />
                                        <ComboBoxItem Content="Ctrl + Shift + V" />
                                        <ComboBoxItem Content="Alt + `" />
                                        <ComboBoxItem Content="Ctrl + Alt + V" />
                                        <ComboBoxItem Content="Alt + C" />
                                    </ComboBox>
                                    <Button x:Name="RecordHotkeyBtn"
                                            Content="录制自定义键位"
                                            Click="RecordHotkeyBtn_Click"
                                            LostFocus="RecordHotkeyBtn_LostFocus"
                                            PreviewKeyDown="RecordHotkeyBtn_PreviewKeyDown" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8B0;" Style="{StaticResource CardIconStyle}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="跟随输入光标弹出" />
                                    <TextBlock Text="在打字光标旁弹出并避开屏幕边缘；关闭后跟随鼠标位置" Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="FollowCaretSwitch" Grid.Column="2" OnContent="开" OffContent="关" MinWidth="0" Toggled="FollowCaretSwitch_Toggled" />
                            </Grid>
                        </Border>

                        <TextBlock Text="系统" Style="{StaticResource GroupHeaderStyle}" />

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7E8;" Style="{StaticResource CardIconStyle}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="开机自动启动" />
                                    <TextBlock Text="登录 Windows 时静默启动到系统托盘" Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AutoStartSwitch" Grid.Column="2" OnContent="开" OffContent="关" MinWidth="0" Toggled="AutoStartSwitch_Toggled" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8FC;" Style="{StaticResource CardIconStyle}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="在开始菜单中显示" />
                                    <TextBlock Text="添加开始菜单快捷方式，可在开始菜单和 Windows 搜索中找到 FluentClip" Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="StartMenuSwitch" Grid.Column="2" OnContent="开" OffContent="关" MinWidth="0" Toggled="StartMenuSwitch_Toggled" />
                            </Grid>
                        </Border>

                        <TextBlock Text="外观" Style="{StaticResource GroupHeaderStyle}" />

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE790;" Style="{StaticResource CardIconStyle}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="应用主题" />
                                    <TextBlock Text="剪贴板面板与设置窗口的颜色模式" Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                                <ComboBox x:Name="ThemeCombo" Grid.Column="2" Width="170" VerticalAlignment="Center" SelectionChanged="ThemeCombo_SelectionChanged">
                                    <ComboBoxItem Content="跟随系统" />
                                    <ComboBoxItem Content="深色" />
                                    <ComboBoxItem Content="浅色" />
                                </ComboBox>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ===================== 存储与缓存 ===================== -->
                    <StackPanel x:Name="StoragePage" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="占用情况" Style="{StaticResource GroupHeaderStyle}" />

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="10" VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="StorageStatsText" Text="正在读取缓存占用..." Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="StorageQuotaLabel" Grid.Column="1" Text="上限 500 MB" Style="{StaticResource CardDescriptionStyle}" />
                                </Grid>
                                <ProgressBar x:Name="StorageProgressBar" Minimum="0" Maximum="100" Value="0" />
                                <TextBlock x:Name="StorageBreakdownText" Text="共 0 条记录" Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="缓存目录" Style="{StaticResource GroupHeaderStyle}" />

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8B7;" Style="{StaticResource CardIconStyle}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="历史记录与图片的存储位置" />
                                        <TextBlock Text="图片按 SHA-256 去重存储；可改到任意磁盘并迁移现有记录" Style="{StaticResource CardDescriptionStyle}" />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="CacheDirTextBox" PlaceholderText="例如 D:\ClipboardCache" />
                                    <Button Grid.Column="1" Content="浏览..." Click="BrowseCacheDirBtn_Click" />
                                    <Button Grid.Column="2" Content="打开文件夹" Click="OpenCacheDirBtn_Click" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="MigrateExistingCheckBox" IsChecked="True" Content="切换时迁移现有历史记录与图片" />
                                    <Button x:Name="ApplyCacheDirBtn" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Content="应用新目录" Click="ApplyCacheDirBtn_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="容量与清理" Style="{StaticResource GroupHeaderStyle}" />

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xEB9F;" Style="{StaticResource CardIconStyle}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="图片缓存空间上限" />
                                    <TextBlock Text="超出后自动删除最旧的未收藏图片" Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                                <ComboBox x:Name="MaxSizeCombo" Grid.Column="2" Width="170" VerticalAlignment="Center" SelectionChanged="QuotaCombo_SelectionChanged">
                                    <ComboBoxItem Content="100 MB" />
                                    <ComboBoxItem Content="300 MB" />
                                    <ComboBoxItem Content="500 MB (推荐)" />
                                    <ComboBoxItem Content="1 GB" />
                                    <ComboBoxItem Content="2 GB" />
                                    <ComboBoxItem Content="不限制" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE81C;" Style="{StaticResource CardIconStyle}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="最大历史保留条数" />
                                    <TextBlock Text="★ 收藏的条目不计入，也不会被删除" Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                                <ComboBox x:Name="MaxCountCombo" Grid.Column="2" Width="170" VerticalAlignment="Center" SelectionChanged="QuotaCombo_SelectionChanged">
                                    <ComboBoxItem Content="200 条" />
                                    <ComboBoxItem Content="500 条 (推荐)" />
                                    <ComboBoxItem Content="1000 条" />
                                    <ComboBoxItem Content="2000 条" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE74D;" Style="{StaticResource CardIconStyle}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="清理未收藏的记录" />
                                    <TextBlock Text="删除所有未收藏的历史与不再使用的图片缓存" Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="立即清理" VerticalAlignment="Center" Click="CleanUnpinnedCacheBtn_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ===================== 关于 ===================== -->
                    <StackPanel x:Name="AboutPage" Spacing="4" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,20,0,0">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="ms-appx:///Assets/AppIcon.png" Width="48" Height="48" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="FluentClip" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock x:Name="VersionText" Text="版本" Style="{StaticResource CardDescriptionStyle}" />
                                    <TextBlock Text="Windows 11 剪贴板历史管理器 · WinUI 3 + .NET Native AOT" Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE9F9;" Style="{StaticResource CardIconStyle}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="配置与错误日志" />
                                    <TextBlock Text="bootstrap.json 与 error.log 所在文件夹，反馈问题时可附上日志" Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="打开文件夹" VerticalAlignment="Center" Click="OpenDataFolderBtn_Click" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE774;" Style="{StaticResource CardIconStyle}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="项目主页" />
                                    <TextBlock Text="源代码、更新与问题反馈" Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                                <HyperlinkButton Grid.Column="2" Content="GitHub" VerticalAlignment="Center" NavigateUri="https://github.com/FriDaysNoel/FluentClip" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
